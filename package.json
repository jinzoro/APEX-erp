    "chart.js": "4.4.7",
    "class-variance-authority": "^0.7.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^1.80.0",
    "motion-dom": "^12.0.0",
    "motion-utils": "^12.0.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.92.0",
    "react-router-dom": "^6.28.0",
    "zod": "^3.25.76"
