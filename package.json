    "postcss": "^8.5.33",
    "prettier": "^3.4.0",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.2.0",
